{
	"name": "iota-monorepo",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"test": "turbo run test",
		"test:dev": "turbo run test -- --run",
		"icons": "pnpm --filter ./apps/icons",
		"explorer-dev": "turbo --filter iota-explorer --filter apps-backend dev",
		"wallet-dev": "turbo --filter ./apps/wallet --filter apps-backend dev",
		"wallet-dashboard-dev": "turbo --filter ./apps/wallet-dashboard --filter apps-backend dev",
		"evm-bridge": "turbo --filter ./apps/evm-bridge",
		"evm-bridge-dev": "turbo --filter ./apps/evm-bridge --filter apps-backend dev",
		"ui-kit": "turbo --filter ./apps/ui-kit",
		"explorer": "turbo --filter iota-explorer",
		"wallet": "turbo --filter ./apps/wallet",
		"wallet-dashboard": "turbo --filter ./apps/wallet-dashboard",
		"sdk-packages": "pnpm turbo run build --filter=./sdk/* --filter=./apps/ui-kit --filter=./apps/ui-icons",
		"sdk": "turbo --filter ./sdk/typescript",
		"signers": "turbo --filter ./sdk/signers",
		"bcs": "turbo --filter ./sdk/bcs",
		"isc-sdk": "turbo --filter ./sdk/isc-sdk",
		"apps-backend": "turbo --filter apps-backend",
		"iota-docs": "turbo --filter iota-docs",
		"changeset-publish": "pnpm changeset publish",
		"changeset-version": "pnpm changeset version && pnpm --filter @iota/iota-sdk codegen:version",
		"prettier:check": "prettier -c --ignore-unknown .",
		"prettier:fix": "prettier -w --ignore-unknown .",
		"prettier:fix:watch": "onchange '**' -i -f add -f change -j 5 -- prettier -w --ignore-unknown {{file}}",
		"eslint:check": "eslint --max-warnings=0 .",
		"eslint:fix": "pnpm run eslint:check --fix",
		"lint": "pnpm run eslint:check && pnpm run prettier:check",
		"lint:fix": "pnpm run eslint:fix && pnpm run prettier:fix",
		"prepare": "husky",
		"codegen": "turbo run codegen",
		"update:deps": "./secure-pnpm-update-and-scan.sh"
	},
	"overrides": {
		"path-to-regexp@<0.1.12": "^0.1.12",
		"image-size@<1.1.1": "^1.2.1",
		"multer@<2.1.1": "2.1.1",
		"form-data@>=4.0.0 <4.0.4": "^4.0.4",
		"sha.js": "^2.4.12",
		"ua-parser-js": "1.0.40",
		"graphql": "16.14.0",
		"axios": "0.31.1",
		"tar": "7.5.11",
		"serialize-javascript": "7.0.5",
		"uuid": "11.1.1",
		"qs": "6.15.2",
		"cookie": "0.7.2",
		"tmp": "0.2.6",
		"elliptic": "6.6.1",
		"turbo": "2.9.14",
		"happy-dom": "20.8.9",
		"cross-spawn@<6.0.6": "6.0.6",
		"glob@>=10.2.0 <10.5.0": "10.5.0",
		"lodash": "4.18.1",
		"minimatch@>=9.0.0 <9.0.7": "9.0.7",
		"next": "15.5.18",
		"picomatch": "4.0.4",
		"rollup@<2.80.0": "2.80.0",
		"valibot": "1.2.0",
		"ajv@<7": "6.14.0",
		"ajv@>=7 <8.18.0": "8.18.0",
		"esbuild@<=0.24.2": "0.25.12",
		"file-type": "21.3.2",
		"js-yaml": "4.1.1",
		"postcss": "8.5.10",
		"prismjs": "1.30.0",
		"vite": "6.4.2",
		"webpack-dev-server": "5.2.4",
		"ws": "8.20.1",
		"yaml": "1.10.3",
		"webpack": "5.104.1",
		"typescript": "5.8.3",
		"@noble/curves": "1.9.2",
		"@tanstack/react-query": "5.56.2",
		"@tanstack/react-query-persist-client": "5.56.2",
		"@tanstack/react-query-devtools": "5.58.0"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@nestjs/core",
		"@parcel/watcher",
		"@scarf/scarf",
		"@sentry/cli",
		"@swc/core",
		"@tailwindcss/oxide",
		"@tree-sitter-grammars/tree-sitter-yaml",
